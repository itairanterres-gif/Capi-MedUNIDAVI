# Chave da API da Anthropic. Usada SOMENTE no servidor (rotas app/api/*).
# Nunca prefixe com NEXT_PUBLIC_: isso a exporia ao navegador.
ANTHROPIC_API_KEY=sk-ant-...

# Modelo. Configurável para trocar sem alterar código.
ANTHROPIC_MODEL=claude-sonnet-5

# Limites de tokens por turno (controle de custo).
MAX_TOKENS_PACIENTE=400
MAX_TOKENS_AVALIADOR=2000
